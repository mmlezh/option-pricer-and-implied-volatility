PROJECT_NAME = "Option Pricer — Homework"
PROJECT_NUMBER = "@PROJECT_VERSION@"
OUTPUT_DIRECTORY = "@PROJECT_BINARY_DIR@/docs"
INPUT = "@PROJECT_SOURCE_DIR@/README.md" "@PROJECT_SOURCE_DIR@/AGENTS.md" "@PROJECT_SOURCE_DIR@/include" "@PROJECT_SOURCE_DIR@/src"
RECURSIVE = YES
FILE_PATTERNS = *.hpp *.cpp *.md
EXTRACT_ALL = YES
GENERATE_HTML = YES
GENERATE_LATEX = NO
USE_MDFILE_AS_MAINPAGE = "@PROJECT_SOURCE_DIR@/README.md"
FULL_PATH_NAMES = NO
QUIET = YES
WARN_IF_UNDOCUMENTED = NO
WARN_AS_ERROR = YES
HAVE_DOT = NO
